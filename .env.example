# Neon PostgreSQL Cloud Database Connection (Recommended)
# Format: postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Or Local PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=angiolens_db
DB_USER=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD
DB_SSLMODE=

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=YOUR_SECRET_KEY

# SMTP Email Notification Configuration (e.g. Gmail, Outlook, AWS SES)
# If left empty, emails are logged in simulation mode in the server console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_SENDER_EMAIL=no-reply@angiolens.com
SMTP_SENDER_NAME=AngioLens Medical Board
SMTP_USE_TLS=True
SMTP_USE_SSL=False